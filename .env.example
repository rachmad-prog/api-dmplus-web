# ====== Database ======
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dmplus_clone?schema=public"

# ====== Server ======
PORT=4000
CLIENT_URL="https://dmplus-web.vercel.app"
JWT_SECRET="ganti_dengan_random_string_yang_panjang"

# Opsional — secret khusus untuk tanda-tangan soal captcha login admin.
# Kalau tidak diisi, otomatis pakai JWT_SECRET di atas.
CAPTCHA_SECRET="ganti_dengan_random_string_lain_yang_panjang"

# ====== Bank Transfer manual (tampil di halaman checkout) ======
# Nilai ini hanya dipakai sebagai NILAI AWAL saat database masih kosong.
# Setelah itu, atur & ubah nomor rekening langsung dari Dashboard Admin > Rekening Bank.
BANK_NAME="Mandiri"
BANK_ACCOUNT_NUMBER="876782766373421"
BANK_ACCOUNT_HOLDER="PT DM PLUS INDONESIA"

# ====== Midtrans (Sandbox dulu, ganti ke production saat live) ======
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false

# ====== Gmail (untuk kirim notifikasi order & status pembayaran) ======
# Gunakan Gmail App Password (bukan password akun biasa):
# https://myaccount.google.com/apppasswords  (butuh 2FA aktif dulu)
GMAIL_USER="bisnis@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
NOTIFY_ADMIN_EMAIL="admin@dmplus.id"

# ====== WhatsApp (tombol chat, tanpa auto-reply) ======
WHATSAPP_NUMBER="628111848185"
